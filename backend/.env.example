# Copy this file to ".env" and fill in your real key.
# NEVER commit the real ".env" file to GitHub — it is already in .gitignore.

ANTHROPIC_API_KEY=your-real-api-key-here

# Leave MOCK_MODE=true to test the app for free without calling the real API.
# Set it to false (or remove it) once you add a real API key above.
MOCK_MODE=true
